# BCS2050 Digital Twin — Runtime & Commercial API Configuration
# Copy to `.env` (backend) and `frontend/.env.local` (Vite build/dev) as needed.

# --- Backend Data & Ontology Integration ---
BCS2050_USE_BIGQUERY=false
GOOGLE_CLOUD_PROJECT=bcs2050
BQ_LOCATION=northamerica-south1
BQ_DATASET=bcs2050_intelligence_sandbox
BCS2050_DATA_DIR=./data
BCS2050_PORT=8050

# --- Optional Paid Commercial 3D & GIS API Keys ---
# 1. Google Maps Platform (Photorealistic 3D Tiles in CesiumJS & deck.gl)
VITE_GOOGLE_MAPS_API_KEY=

# 2. Cesium ion Commercial Token (Cesium World Terrain & Custom 3D Tilesets)
VITE_CESIUM_ION_TOKEN=

# 3. MapTiler / Mapbox Key (High-DPI Vector Basemaps & Terrain RGB)
VITE_MAPTILER_KEY=

# 4. Esri ArcGIS Platform API Key (ArcGIS Urban / Feature / Imagery Integration)
VITE_ARCGIS_API_KEY=

# 5. Optional Override for Frontend -> Backend API URL (leave empty when served together)
VITE_API_BASE_URL=

# --- Security, CORS, Rate Limiting & Autodesk Interoperability ---
ALLOWED_ORIGINS=https://bcs2050.com,https://www.bcs2050.com,https://panel.bcs2050.com,https://twin.bcs2050.com,http://localhost:5173
BCS2050_HEAVY_RPM=12
BCS2050_READ_RPM=180
BCS2050_REQUIRE_AUTH_FOR_EXPORTS=false
BCS2050_PLANNER_API_TOKENS=

# Optional Autodesk APS / ACC & Tandem Identifiers (store secrets in GCP Secret Manager)
AUTODESK_APS_CLIENT_ID=
AUTODESK_TANDEM_FACILITY_URN=
